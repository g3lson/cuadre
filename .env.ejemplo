# La URL pública de la API. La usan la vuelta del permiso de Chinola y los
# enlaces de los reportes, así que tiene que ser la de fuera, no la del contenedor.
CUADRE_SITIO=https://api.cuadre.fente.com.do
CUADRE_VERSION=1.0.0

# Correo: el código de seis dígitos para entrar. Sin esto solo se puede entrar
# con Apple.
RESEND_API_KEY=
CUADRE_CORREO_DE=Cuadre <soporte@fente.com.do>

# El bundle id de la app. Un token de Apple vale para la app a la que se emitió.
CUADRE_APPLE_AUD=do.com.fente.cuadre

# El router de modelos que ya corre en este servidor, por la red interna.
CUADRE_IA_BASE=http://freellmapi:3001/v1
CUADRE_IA_CLAVE=
CUADRE_IA_MODELO=claude-haiku-4-5
CUADRE_IA_RESPALDO=auto

# Chinola. El client_id se registra solo la primera vez; ponerlo aquí solo hace
# falta si se quiere fijar uno concreto.
CUADRE_CHINOLA_SITIO=https://chinola.fente.com.do
CUADRE_CHINOLA_CLIENTE=

# Cifras agregadas para Vigía.
CUADRE_METRICAS_CLAVE=
